# kurulum.sh bu dosyayı .env olarak kopyalar ve doldurur. .env git'e girmez.

# Saat dilimi (Almanya: Europe/Berlin, Türkiye: Europe/Istanbul)
TZ=Europe/Berlin

# Mosquitto kullanıcı bilgileri (Home Assistant ve Zigbee2MQTT bunlarla bağlanır)
MQTT_USER=azili
MQTT_PASSWORD=

# Zigbee USB çubuğu: `ls -l /dev/serial/by-id/` çıktısındaki tam yol
ZIGBEE_ADAPTER=/dev/serial/by-id/BURAYA-CUBUK-ADI
# Çubuk tipi: zstack (Sonoff ZBDongle-P, CC2652), ember (Sonoff ZBDongle-E, EFR32),
#             deconz (ConBee II/III), zigate
ZIGBEE_ADAPTER_TYPE=zstack
